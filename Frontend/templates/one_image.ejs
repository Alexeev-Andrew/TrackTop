<div class="slider__item">
    <div>
        <a href="<%= base %>/images/<%= image %>" class="fancybox" rel="images-single"  >
            <img  class="one_image" 
            <% if (order == 1) { %>
                fetchpriority="high"
                loading="eager"
            <% } else { %>
                loading="lazy"
            <% } %>
            src="/images/<%= image %>" alt='<%= alt %>'>
        </a>
<!--        <i class="fa fa-arrows-alt icons full_screen_btn"></i>-->
    </div>
</div>